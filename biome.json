{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "apps/backend/src/**",
      "apps/backend/scripts/**/*.mjs",
      "scripts/**",
      "apps/backend/containers/**/*.mjs",
      "apps/backend/containers/**/package.json",
      "apps/backend/package.json",
      "apps/backend/tsconfig.json",
      "apps/backend/wrangler.jsonc",
      "apps/web/src/**",
      "apps/web/package.json",
      "apps/web/tsconfig.json",
      "apps/web/vite.config.ts",
      "apps/web/wrangler.jsonc",
      "packages/contracts/src/**",
      "packages/contracts/package.json",
      "packages/ui/src/**",
      "packages/ui/package.json",
      "package.json",
      "vitest.config.ts",
      "biome.json",
      "knip*.json"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "lineEnding": "auto",
    "lineWidth": 140
  },
  "linter": {
    "enabled": true,
    "rules": {
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 15
          }
        }
      }
    }
  },
  "javascript": {
    "formatter": {
      "bracketSpacing": false,
      "indentWidth": 4,
      "jsxQuoteStyle": "double",
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "all"
    }
  },
  "json": {
    "formatter": {
      "indentWidth": 2
    }
  },
  "css": {
    "formatter": {
      "indentWidth": 4,
      "quoteStyle": "single"
    },
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["**/*.svelte"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedImports": "off",
            "noUnusedVariables": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/backend/containers/myoc-docker-sharp/server.mjs"],
      "linter": {
        "rules": {
          "complexity": {
            "useLiteralKeys": "off"
          }
        }
      }
    }
  ]
}
