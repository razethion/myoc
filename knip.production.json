{
  "$schema": "./node_modules/knip/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs!", "!scripts/*.test.mjs!"],
      "project": ["scripts/*.mjs!", "!scripts/*.test.mjs!"]
    },
    "apps/backend": {
      "entry": ["src/index.ts!", "scripts/*.mjs!"],
      "project": ["src/**/*.{ts,tsx}!", "scripts/*.mjs!", "!src/**/*.test.{ts,tsx}!", "!src/test/**!"]
    },
    "apps/web": {
      "entry": ["src/routes/**/+*.{ts,svelte}!"],
      "project": ["src/**/*.{ts,svelte}!"]
    },
    "packages/contracts": {
      "project": ["src/**/*.ts!"]
    },
    "packages/ui": {
      "entry": ["src/app.css!"],
      "project": ["src/**/*.css!"]
    },
    "apps/backend/containers/myoc-docker-sharp": {
      "entry": ["server.mjs!"],
      "project": ["*.mjs!"]
    }
  },
  "tags": ["-@internal"],
  "ignoreBinaries": ["py"],
  "ignoreDependencies": ["@simplewebauthn/browser", "cropperjs", "zod"]
}
