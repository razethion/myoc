{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "myoc",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-10",
  "workers_dev": false,
  "dev": {
    "enable_containers": false
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "limits": {
    "subrequests": 1000000
  },
  "containers": [
    {
      "name": "myoc-docker-sharp",
      "class_name": "MyocDockerSharpContainer",
      "image": "./containers/myoc-docker-sharp/Dockerfile",
      "image_build_context": "./containers/myoc-docker-sharp",
      "instance_type": "standard-4",
      "max_instances": 8
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "MYOC_DOCKER_SHARP_CONTAINER",
        "class_name": "MyocDockerSharpContainer"
      }
    ]
  },
  "workflows": [
    {
      "name": "myoc-regenerate-media-previews",
      "binding": "REGENERATE_MEDIA_PREVIEWS_WORKFLOW",
      "class_name": "RegenerateMediaPreviewsWorkflow",
      "limits": {
        "steps": 25000
      }
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "MEDIA_PREVIEW_REGENERATION_QUEUE_0",
        "queue": "myoc-media-preview-regeneration-0"
      },
      {
        "binding": "MEDIA_PREVIEW_REGENERATION_QUEUE_1",
        "queue": "myoc-media-preview-regeneration-1"
      },
      {
        "binding": "MEDIA_PREVIEW_REGENERATION_QUEUE_2",
        "queue": "myoc-media-preview-regeneration-2"
      },
      {
        "binding": "MEDIA_PREVIEW_REGENERATION_DLQ",
        "queue": "myoc-media-preview-regeneration-dlq"
      },
      {
        "binding": "IMAGE_PROCESSING_QUEUE_0",
        "queue": "myoc-image-processing-0"
      },
      {
        "binding": "IMAGE_PROCESSING_QUEUE_1",
        "queue": "myoc-image-processing-1"
      },
      {
        "binding": "IMAGE_PROCESSING_QUEUE_2",
        "queue": "myoc-image-processing-2"
      },
      {
        "binding": "IMAGE_PROCESSING_DLQ",
        "queue": "myoc-image-processing-dlq"
      }
    ],
    "consumers": [
      {
        "queue": "myoc-media-preview-regeneration-0",
        "max_batch_size": 1,
        "max_batch_timeout": 0,
        "max_retries": 2,
        "dead_letter_queue": "myoc-media-preview-regeneration-dlq",
        "max_concurrency": 3,
        "retry_delay": 1
      },
      {
        "queue": "myoc-media-preview-regeneration-1",
        "max_batch_size": 1,
        "max_batch_timeout": 0,
        "max_retries": 2,
        "dead_letter_queue": "myoc-media-preview-regeneration-dlq",
        "max_concurrency": 3,
        "retry_delay": 1
      },
      {
        "queue": "myoc-media-preview-regeneration-2",
        "max_batch_size": 1,
        "max_batch_timeout": 0,
        "max_retries": 2,
        "dead_letter_queue": "myoc-media-preview-regeneration-dlq",
        "max_concurrency": 3,
        "retry_delay": 1
      },
      {
        "queue": "myoc-image-processing-0",
        "max_batch_size": 1,
        "max_batch_timeout": 0,
        "max_retries": 10,
        "dead_letter_queue": "myoc-image-processing-dlq",
        "max_concurrency": 8,
        "retry_delay": 1
      },
      {
        "queue": "myoc-image-processing-1",
        "max_batch_size": 1,
        "max_batch_timeout": 0,
        "max_retries": 10,
        "dead_letter_queue": "myoc-image-processing-dlq",
        "max_concurrency": 8,
        "retry_delay": 1
      },
      {
        "queue": "myoc-image-processing-2",
        "max_batch_size": 1,
        "max_batch_timeout": 0,
        "max_retries": 10,
        "dead_letter_queue": "myoc-image-processing-dlq",
        "max_concurrency": 8,
        "retry_delay": 1
      },
      {
        "queue": "myoc-media-preview-regeneration-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 10,
        "max_concurrency": 1,
        "retry_delay": 1
      },
      {
        "queue": "myoc-image-processing-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 10,
        "max_concurrency": 1,
        "retry_delay": 1
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MyocDockerSharpContainer"]
    }
  ],
  "triggers": {
    "crons": ["* * * * *", "0 8 * * *", "0 9 * * *", "30 9 * * *", "0 10 * * *"]
  },
  "assets": {
    "directory": "./public"
  },
  "vars": {
    "CLOUDFLARE_ACCOUNT_ID": "9b7b3de391cdb5368247e2c468ad1643",
    "D1_DATABASE_ID": "909ada8f-fc57-47ad-83e1-18ffe863debb",
    "IMAGE_PROCESSING_DLQ_NAME": "myoc-image-processing-dlq",
    "IMAGE_UPLOAD_ASYNC_ENABLED": "true",
    "MEDIA_PREVIEW_REGENERATION_DLQ_NAME": "myoc-media-preview-regeneration-dlq",
    "MEDIA_PREVIEW_OVERFLOW_ENABLED": "true",
    "MEDIA_PUBLIC_BASE_URL": "https://m.myoc.art",
    "RECENT_FEED_BLOCK_ITEMS": "96",
    "RECENT_FEED_CLEANUP_ENABLED": "true",
    "RECENT_FEED_PUBLISH_ENABLED": "true",
    "RECENT_FEED_PUBLIC_BASE_URL": "https://feed-data.myoc.art",
    "RECENT_FEED_RETENTION_DAYS": "30"
  },
  "secrets": {
    "required": ["D1_REST_API_TOKEN", "PREVIEW_PROCESSOR_TOKEN", "RECENT_FEED_CURSOR_SECRET"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "myoc-db",
      "database_id": "909ada8f-fc57-47ad-83e1-18ffe863debb"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "3f4e8c4c7ed648ed9a699a0a67b727a7"
    }
  ],
  "ratelimits": [
    {
      "name": "AUTH_NETWORK_RATE_LIMITER",
      "namespace_id": "539139901",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "AUTH_IDENTITY_BURST_RATE_LIMITER",
      "namespace_id": "539139902",
      "simple": {
        "limit": 5,
        "period": 10
      }
    },
    {
      "name": "AUTH_IDENTITY_SUSTAINED_RATE_LIMITER",
      "namespace_id": "539139903",
      "simple": {
        "limit": 15,
        "period": 60
      }
    },
    {
      "name": "AUTH_CHALLENGE_RATE_LIMITER",
      "namespace_id": "539139904",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGE_SOURCE_BUCKET",
      "bucket_name": "myoc-image-sources",
      "preview_bucket_name": "myoc-image-sources-dev",
      "remote": true
    },
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "myoc",
      "preview_bucket_name": "myoc-dev",
      "remote": true
    },
    {
      "binding": "DB_BACKUP_BUCKET",
      "bucket_name": "myoc-db-bak",
      "remote": true
    },
    {
      "binding": "RECENT_FEED_BUCKET",
      "bucket_name": "myoc-recent-feed-prod",
      "preview_bucket_name": "myoc-recent-feed-dev",
      "remote": true
    }
  ]
}
