# Response headers for static assets served from this directory.
# Workers static assets apply this file to asset responses only, never to Worker responses.
# scripts/sync-web-assets.mjs copies this file to the web app project root, so the same rules
# govern the asset responses served on myoc.art (the web app serves these assets).

/*
  X-Content-Type-Options: nosniff

/app.css
  Cache-Control: public, max-age=300, stale-while-revalidate=3600
  X-Content-Type-Options: nosniff

/assets/*
  Cache-Control: public, max-age=300, stale-while-revalidate=3600
  X-Content-Type-Options: nosniff

/vendor/*
  Cache-Control: public, max-age=300, stale-while-revalidate=3600
  X-Content-Type-Options: nosniff
